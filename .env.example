# Smart Bamboo production deployment example.
# Copy to .env and replace all passwords/tokens before running docker compose.

MYSQL_DATABASE=smart_bamboo
MYSQL_USER=smart_bamboo
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me

SMART_BAMBOO_DEPLOYMENT_MODE=production
SMART_BAMBOO_STORAGE_BACKEND=mysql
SMART_BAMBOO_DATABASE_URL=mysql://smart_bamboo:change-me@db:3306/smart_bamboo?charset=utf8mb4
SMART_BAMBOO_APP_PORT=8010
SMART_BAMBOO_DB_PORT=3307
SMART_BAMBOO_MYSQL_WRITE_BATCH_SIZE=500
SMART_BAMBOO_IDENTITY_LOOKUP_BATCH_SIZE=500
SMART_BAMBOO_VECTOR_TILE_CACHE_TTL_SECONDS=300
SMART_BAMBOO_VECTOR_TILE_CACHE_MAX_BYTES=2147483648
SMART_BAMBOO_VECTOR_TILE_CACHE_MAX_AGE_SECONDS=86400
SMART_BAMBOO_VECTOR_TILE_CACHE_PRUNE_INTERVAL_SECONDS=60

REMOTE_SENSING_CATALOG_BACKEND=mysql
REMOTE_SENSING_DATABASE_URL=mysql://smart_bamboo:change-me@db:3306/smart_bamboo?charset=utf8mb4
REMOTE_SENSING_DATA_DIR=/app/data/remote-sensing
REMOTE_SENSING_IMPORT_DIRS=/app/data/remote-sensing/inbox
REMOTE_SENSING_TASK_WORKERS=1
REMOTE_SENSING_SERVE_STATIC=1
REMOTE_SENSING_AUTH_REQUIRED=1
REMOTE_SENSING_API_TOKENS={"admin-token":{"user":"admin","roles":["admin"],"projects":["*"],"areas":["*"]}}
REMOTE_SENSING_CORS_ORIGINS=https://bamboo.example.gov.cn
REMOTE_SENSING_TIANDITU_TK=
# Optional: reuse a central Smart Bamboo tile cache instead of distributing the server key.
REMOTE_SENSING_TIANDITU_PROXY_BASE_URL=

GEOSERVER_PORT=8080
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=change-me
